{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git fetch*": "ask",
      "git pull*": "ask",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "yarn why *": "allow",
      "yarn up *": "allow",
      "yarn install*": "allow",
      "yarn build*": "allow",
      "yarn test*": "allow",
      "yarn npm info *": "allow",
      "yarn set resolution *": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": "deny"
  }
}
